# Normalise line endings in the repository; pick the right ones on checkout.
* text=auto

# Unix scripts must keep LF or they do not run.
*.sh            text eol=lf
tools/hooks/*   text eol=lf

# Windows scripts and the file players edit in Notepad.
*.bat           text eol=crlf
*.ps1           text eol=crlf
*.ini           text eol=crlf
*.def           text eol=crlf
