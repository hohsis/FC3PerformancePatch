; Export table of the version.dll proxy (MSVC linker).
; The linker resolves the undecorated internal names to the __stdcall symbols.
LIBRARY version
EXPORTS
    GetFileVersionInfoA         = fc3pp_GetFileVersionInfoA         @1
    GetFileVersionInfoByHandle  = fc3pp_GetFileVersionInfoByHandle  @2
    GetFileVersionInfoExA       = fc3pp_GetFileVersionInfoExA       @3
    GetFileVersionInfoExW       = fc3pp_GetFileVersionInfoExW       @4
    GetFileVersionInfoSizeA     = fc3pp_GetFileVersionInfoSizeA     @5
    GetFileVersionInfoSizeExA   = fc3pp_GetFileVersionInfoSizeExA   @6
    GetFileVersionInfoSizeExW   = fc3pp_GetFileVersionInfoSizeExW   @7
    GetFileVersionInfoSizeW     = fc3pp_GetFileVersionInfoSizeW     @8
    GetFileVersionInfoW         = fc3pp_GetFileVersionInfoW         @9
    VerFindFileA                = fc3pp_VerFindFileA                @10
    VerFindFileW                = fc3pp_VerFindFileW                @11
    VerInstallFileA             = fc3pp_VerInstallFileA             @12
    VerInstallFileW             = fc3pp_VerInstallFileW             @13
    VerLanguageNameA            = fc3pp_VerLanguageNameA            @14
    VerLanguageNameW            = fc3pp_VerLanguageNameW            @15
    VerQueryValueA              = fc3pp_VerQueryValueA              @16
    VerQueryValueW              = fc3pp_VerQueryValueW              @17
